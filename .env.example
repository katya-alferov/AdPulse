# =====================================================================
# AdPulse environment variables (EXAMPLE FILE - safe to commit)
# Copy to .env and change the passwords:   cp .env.example .env
# The real .env file is ignored by Git and must never be committed.
# =====================================================================

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=adpulse
POSTGRES_USER=adpulse
POSTGRES_PASSWORD=change_me_local_only

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EVENTS_TOPIC=ad-events
KAFKA_DLQ_TOPIC=ad-events-dlq
KAFKA_TOPIC_PARTITIONS=3

# ---- Object storage (S3-compatible, local SeaweedFS) ----
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=adpulse_local_key
S3_SECRET_KEY=change_me_local_secret
S3_BUCKET=adpulse-lake
S3_REGION=us-east-1

# ---- Event generator ----
EVENTS_PER_SECOND=40
GENERATOR_DURATION_SECONDS=0
DUPLICATE_RATE=0.02
INVALID_RATE=0.01
LATE_EVENT_RATE=0.03
BOT_BURST_PROBABILITY=0.01
GENERATOR_SEED=

# ---- Spark ----
SPARK_TRIGGER_SECONDS=20
SPARK_WATERMARK_MINUTES=10
SUSPICIOUS_CLICK_THRESHOLD=8

# ---- API / dashboard ----
API_BASE_URL=http://api:8000
LOG_LEVEL=INFO
